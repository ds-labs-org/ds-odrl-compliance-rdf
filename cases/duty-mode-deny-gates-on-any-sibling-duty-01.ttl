@base <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/cases/duty-mode-deny-gates-on-any-sibling-duty-01> .
@prefix :      <#> .
@prefix dsc:   <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/ns#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Engine-verified against ds-odrl-engine-rs v0.23.0 via a scratch
# engine::evaluate_request_detailed call over the hand-transcribed wire
# JSON equivalent of this file's own :request. Written to isolate a
# SUSPECTED bug (`decision::derive_detailed_rule_reports`'s own
# `duty_gate_violated` local inspects only `rule.duty.first()`) -- on
# inspection of the real v0.23.0 source, this is NOT a real bug for this
# scenario: `Rule::grants`'s own `duties_resolved` already checks EVERY
# sibling `odrl:duty` (`self.duty.iter().all(...)`), and that is what both
# `decision::decide`'s coarse decision AND
# `derive_detailed_rule_reports`'s own `permission_grants[rule_index]`
# gate on -- `duty_gate_violated`'s duty[0]-only check only ever matters
# under dutyMode=Advise (where `grants()` does not consult duties at all),
# never under dutyMode=Deny, where the first `!permission_grants[..]`
# branch already catches an outstanding duty at ANY sibling index before
# `duty_gate_violated` is even consulted. This file is therefore
# published as REGRESSION COVERAGE confirming the correct behavior (ANY
# outstanding sibling duty gates the whole permission under dutyMode=Deny)
# already holds, not as a demonstration of a bug -- see
# ds-odrl-engine-rs's own v0.23.1 release notes for the full writeup of
# why this one was not confirmed.

:testcase a dsc:TestCase ;
    dct:title "dutyMode=Deny: a permission with TWO sibling odrl:duty entries is denied when ANY of them is outstanding, not only the first" ;
    dct:created "2026-09-17T10:00:00Z"^^xsd:dateTime ;
    dct:creator <mailto:shared-claude@unxwares.com> ;
    dsc:request :request ;
    dsc:expectedOutcome :report-a .

:asset-doc  a odrl:Asset .
:ack-log    a odrl:Asset .
:notify-log a odrl:Asset .

:profile a odrl:Profile ;
    odrl:action odrl:read, odrl:inform ;
    dsc:dutyMode dsc:Deny .

# TWO sibling odrl:duty entries on the SAME permission -- duty[0] is
# resolved by a supplied claim, duty[1] is unconstrained and therefore
# always outstanding, exercising exactly the "ANY duty gates it, not only
# the first" rule this fixture targets.
:perm-read a odrl:Permission ;
    odrl:target :asset-doc ;
    odrl:action odrl:read ;
    odrl:duty :duty-ack, :duty-notify .

:duty-ack a odrl:Duty ;
    odrl:action odrl:inform ;
    odrl:target :ack-log ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand [ a dsc:ClaimKey ; dsc:key "ackGiven" ] ;
        odrl:operator odrl:eq ;
        odrl:rightOperand "true"
    ] .

:duty-notify a odrl:Duty ;
    odrl:action odrl:inform ;
    odrl:target :notify-log .
    # No odrl:constraint -- always outstanding by design: the SECOND
    # sibling duty, which must ALSO gate :perm-read even though the first
    # (:duty-ack) is satisfied.

:claim-ack a dsc:ClaimAssertion ; dsc:key "ackGiven" ; rdf:value "true" .

:policy-a a odrl:Set ;
    odrl:assigner <did:web:provider.example> ;
    odrl:permission :perm-read .

:request a dsc:Request ;
    odrl:target :asset-doc ;
    odrl:action odrl:read ;
    dsc:profile :profile ;
    dsc:policy :policy-a ;
    dsc:claim :claim-ack .

:the-ask a odrl:Request ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:read ; odrl:target :asset-doc ] .

# Expected outcome: :perm-read is denied (Inactive) because :duty-notify
# (duty[1]) is outstanding, even though :duty-ack (duty[0], the only one
# report:conditionReport ever links to) is itself Fulfilled.
:report-a a report:PolicyReport ;
    report:policy :policy-a ;
    report:policyRequest :the-ask ;
    report:ruleReport :rr-a-perm-read , :rr-a-duty-ack , :rr-a-duty-notify .

:rr-a-perm-read a report:PermissionReport ;
    report:rule :perm-read ;
    report:activationState report:Inactive ;        # duty[1] outstanding gates the WHOLE permission
    report:attemptState report:Attempted ;
    report:performanceState report:Unperformed ;
    report:deonticState report:NonSet ;
    report:conditionReport :rr-a-duty-ack ;          # only duty[0] is ever linked via report:conditionReport
    report:premiseReport :pr-a-action, :pr-a-target .

:pr-a-action a report:ActionReport ; report:satisfactionState report:Satisfied .
:pr-a-target a report:TargetReport ; report:satisfactionState report:Satisfied .

:rr-a-duty-ack a report:DutyReport ;
    report:rule :duty-ack ;
    report:activationState report:Active ;
    report:performanceState report:Performed ;
    report:deonticState report:Fulfilled .

:rr-a-duty-notify a report:DutyReport ;
    report:rule :duty-notify ;
    report:activationState report:Active ;
    report:performanceState report:Unperformed ;
    report:deonticState report:Violated .
