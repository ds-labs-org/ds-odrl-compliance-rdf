@base <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/cases/party-collection-member-is-assignee-01> .
@prefix :      <#> .
@prefix dsc:   <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/ns#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Fills a gap the ds-prose-rs policy catalog found: no case assigned a
# policy to an odrl:PartyCollection. The shape is the W3C ODRL IM's own
# (section 2.3, Examples 9 and 10): an Agreement assigned to team A, and
# murphy odrl:partOf team A, which "means that murphy is an assignee and
# can use the target asset". agreementAssigneeClaim is on and the profile
# is closed, so the grant depends on the membership: without the
# odrl:partOf triple the Agreement would not apply to murphy at all.
# Engine-verified against ds-odrl-engine-rs's compliance-rdf-runner
# (Request.party_collections, read from the identity claim's party's own
# odrl:partOf).

:testcase a dsc:TestCase ;
    dct:title "odrl:PartyCollection: a member of the collection an Agreement is assigned to is its assignee, under a closed profile" ;
    dct:created "2026-10-14T23:30:00Z"^^xsd:dateTime ;
    dct:creator <mailto:shared-claude@unxwares.com> ;
    dsc:request :request ;
    dsc:expectedDecision "Allow" ;
    dsc:expectedOutcome :report-a .

:asset-music a odrl:Asset .

:team-a a odrl:PartyCollection .

:murphy a odrl:Party ;
    odrl:partOf :team-a .

:profile a odrl:Profile ;
    odrl:action odrl:play ;
    dsc:behaviour dsc:Closed ;
    dsc:agreementAssigneeClaim "sub" .

:perm-play a odrl:Permission ;
    odrl:target :asset-music ;
    odrl:action odrl:play .

:policy-a a odrl:Agreement ;
    odrl:assigner <did:web:provider.example> ;
    odrl:assignee :team-a ;
    odrl:permission :perm-play .

:claim-identity a dsc:ClaimAssertion ;
    dsc:key "sub" ;
    rdf:value :murphy .

:request a dsc:Request ;
    odrl:target :asset-music ;
    odrl:action odrl:play ;
    dsc:profile :profile ;
    dsc:policy :policy-a ;
    dsc:claim :claim-identity .

:the-ask a odrl:Request ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:play ; odrl:target :asset-music ; odrl:assignee :murphy ] .

:report-a a report:PolicyReport ;
    report:policy :policy-a ;
    report:policyRequest :the-ask ;
    report:ruleReport :rr-a-perm-play .

:rr-a-perm-play a report:PermissionReport ;
    report:rule :perm-play ;
    report:activationState report:Active ;
    report:attemptState report:Attempted ;
    report:performanceState report:Performed ;
    report:deonticState report:Fulfilled ;
    report:premiseReport :pr-a-action, :pr-a-target, :pr-a-party .

:pr-a-action a report:ActionReport ; report:satisfactionState report:Satisfied .
:pr-a-target a report:TargetReport ; report:satisfactionState report:Satisfied .
:pr-a-party a report:PartyReport ; report:satisfactionState report:Satisfied .
