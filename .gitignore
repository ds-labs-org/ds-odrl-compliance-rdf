# Generated by Cargo (site's own build output; the workspace has no root
# target/, so this is anchored under site/ explicitly below).
/site/target/

# Generated by Trunk.
/site/dist/
/site/dist.trunk-lock

# Generated by npm/node_packages resolution (Trunk's [[node_packages]]
# pulls PatternFly's CSS/fonts down into site/target/node_modules).
/site/node_modules/
/site/package-lock.json

# site/build.rs's generated test-case index (site/generated/test-index.json)
# -- rebuilt fresh from cases/*.ttl on every build by Trunk.toml's pre_build
# hook, not checked in (mirrors how the ds-odrl-engine-rs-work sibling site
# treats its own generated compliance artifacts).
/site/generated/

# Backup files generated by rustfmt.
**/*.rs.bk

# Editor/OS cruft.
.DS_Store
