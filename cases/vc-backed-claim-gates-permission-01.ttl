@base <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/cases/vc-backed-claim-gates-permission-01> .
@prefix :      <#> .
@prefix dsc:   <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/ns#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix cred:  <https://www.w3.org/2018/credentials#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Engine-verified against ds-odrl-engine-rs v0.23.0 via a scratch
# `engine::evaluate_request_detailed` call over the hand-transcribed wire
# JSON equivalent of this file's own :request. The worked example's own
# VC-backed claim (:claim-clearance, "clearanceLevel") is never actually
# read by any constraint there -- decorative, not load-bearing. This case
# adds the missing genuine example: the SAME claim shape, but referenced
# directly by a permission's own odrl:constraint, so the credential's
# presence is what the grant actually turns on. Confirmed live with a
# second probe (not published here) that removing the claim from the
# request's claims map flips the permission's own report:ConstraintReport
# to report:Unsatisfied and denies it.

:testcase a dsc:TestCase ;
    dct:title "A VC-backed claim that genuinely gates a permission's own constraint, not merely decorative" ;
    dct:created "2026-09-17T09:00:00Z"^^xsd:dateTime ;
    dct:creator <mailto:shared-claude@unxwares.com> ;
    dsc:request :request ;
    dsc:expectedOutcome :report-a .

:asset-classified a odrl:Asset .

:profile a odrl:Profile ;
    odrl:action odrl:read .

:perm-read a odrl:Permission ;
    odrl:target :asset-classified ;
    odrl:action odrl:read ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand [ a dsc:ClaimKey ; dsc:key "clearanceLevel" ] ;
        odrl:operator odrl:eq ;
        odrl:rightOperand "elevated"
    ] .

:policy-a a odrl:Set ;
    odrl:assigner <did:web:provider.example> ;
    odrl:permission :perm-read .

# verified-credential claim -- the VC's own cred:credentialSubject is the
# link, per the vocabulary spec's VC-backed claim shape. This is the part
# the worked example's own :vc-clearance/:claim-clearance never actually
# exercised: here the constraint above reads exactly this key.
:vc-clearance a cred:VerifiableCredential ;
    cred:issuer <https://issuer.example.org/> ;
    cred:validFrom "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    cred:credentialSubject :claim-clearance .

:claim-clearance a dsc:ClaimAssertion ;
    dsc:key "clearanceLevel" ;
    rdf:value "elevated" .

:request a dsc:Request ;
    odrl:target :asset-classified ;
    odrl:action odrl:read ;
    dsc:profile :profile ;
    dsc:policy :policy-a ;
    dsc:claim :claim-clearance .

:the-ask a odrl:Request ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:read ; odrl:target :asset-classified ] .

:report-a a report:PolicyReport ;
    report:policy :policy-a ;
    report:policyRequest :the-ask ;
    report:ruleReport :rr-a-perm-read .

:rr-a-perm-read a report:PermissionReport ;
    report:rule :perm-read ;
    report:activationState report:Active ;
    report:attemptState report:Attempted ;
    report:performanceState report:Performed ;
    report:deonticState report:Fulfilled ;
    report:premiseReport :pr-a-action, :pr-a-target, :pr-a-constraint .

:pr-a-action a report:ActionReport ; report:satisfactionState report:Satisfied .
:pr-a-target a report:TargetReport ; report:satisfactionState report:Satisfied .
:pr-a-constraint a report:ConstraintReport ; report:satisfactionState report:Satisfied .
