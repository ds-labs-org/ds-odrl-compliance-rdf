@base <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/cases/xone-exactly-one-factor-01> .
@prefix :      <#> .
@prefix dsc:   <https://ds-labs-org.github.io/ds-odrl-compliance-rdf/ns#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Engine-verified against ds-odrl-engine-rs v0.23.0 via a scratch
# `engine::evaluate_request_detailed` call over the hand-transcribed wire
# JSON equivalent of this file's own :request. `odrl:xone` is satisfied
# by EXACTLY one matching child, unlike `odrl:or` (at least one) or
# `odrl:and` (all) -- both already exercised elsewhere in this corpus.
# A second probe (not published here, to keep this file single-purpose)
# ran the identical policy with TWO of the three claims true and
# confirmed the permission's own report:ConstraintReport flips to
# report:Unsatisfied -- the exact boundary this operator exists to
# express, which `odrl:or` cannot.

:testcase a dsc:TestCase ;
    dct:title "odrl:xone: a permission gated on exactly one of three access-factor claims being true, not merely at least one" ;
    dct:created "2026-09-17T09:00:00Z"^^xsd:dateTime ;
    dct:creator <mailto:shared-claude@unxwares.com> ;
    dsc:request :request ;
    dsc:expectedOutcome :report-a .

:asset-vault a odrl:Asset .

:profile a odrl:Profile ;
    odrl:action odrl:read .

:constraint-xone a odrl:LogicalConstraint ;
    odrl:xone (
        [ a odrl:Constraint ;
          odrl:leftOperand [ a dsc:ClaimKey ; dsc:key "mfaVerified" ] ;
          odrl:operator odrl:eq ;
          odrl:rightOperand "true" ]
        [ a odrl:Constraint ;
          odrl:leftOperand [ a dsc:ClaimKey ; dsc:key "onPremises" ] ;
          odrl:operator odrl:eq ;
          odrl:rightOperand "true" ]
        [ a odrl:Constraint ;
          odrl:leftOperand [ a dsc:ClaimKey ; dsc:key "vpnConnected" ] ;
          odrl:operator odrl:eq ;
          odrl:rightOperand "true" ]
    ) .

:perm-read a odrl:Permission ;
    odrl:target :asset-vault ;
    odrl:action odrl:read ;
    odrl:constraint :constraint-xone .

:policy-a a odrl:Set ;
    odrl:assigner <did:web:provider.example> ;
    odrl:permission :perm-read .

# Bare environment facts -- exactly one of the three is true.
:claim-mfa a dsc:ClaimAssertion ; dsc:key "mfaVerified"   ; rdf:value "true" .
:claim-onprem a dsc:ClaimAssertion ; dsc:key "onPremises"   ; rdf:value "false" .
:claim-vpn a dsc:ClaimAssertion ; dsc:key "vpnConnected" ; rdf:value "false" .

:request a dsc:Request ;
    odrl:target :asset-vault ;
    odrl:action odrl:read ;
    dsc:profile :profile ;
    dsc:policy :policy-a ;
    dsc:claim :claim-mfa, :claim-onprem, :claim-vpn .

:the-ask a odrl:Request ;
    odrl:permission [ a odrl:Permission ; odrl:action odrl:read ; odrl:target :asset-vault ] .

:report-a a report:PolicyReport ;
    report:policy :policy-a ;
    report:policyRequest :the-ask ;
    report:ruleReport :rr-a-perm-read .

:rr-a-perm-read a report:PermissionReport ;
    report:rule :perm-read ;
    report:activationState report:Active ;
    report:attemptState report:Attempted ;
    report:performanceState report:Performed ;
    report:deonticState report:Fulfilled ;
    report:premiseReport :pr-a-action, :pr-a-target, :pr-a-constraint .

:pr-a-action a report:ActionReport ; report:satisfactionState report:Satisfied .
:pr-a-target a report:TargetReport ; report:satisfactionState report:Satisfied .
:pr-a-constraint a report:ConstraintReport ; report:satisfactionState report:Satisfied .
